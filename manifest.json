{
  "manifest_version": 3,
  "name": "pinspec",
  "version": "0.1.23",
  "description": "Pin a UI change on any page and copy it as one image a coding agent can act on.",
  "action": {
    "default_title": "pinspec",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "homepage_url": "https://github.com/priyaabhatt/pinspec",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Turn pinspec on or off"
    }
  }
}
