{
  "name": "pinspec",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that turns a UI change into one image an AI coding agent can act on.",
  "license": "MIT",
  "author": "Priya Bhatt",
  "homepage": "https://github.com/priyaabhatt/pinspec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyaabhatt/pinspec.git"
  },
  "bugs": {
    "url": "https://github.com/priyaabhatt/pinspec/issues"
  },
  "keywords": [
    "chrome-extension",
    "design-handoff",
    "ai-agents",
    "tailwindcss",
    "design-tokens",
    "annotation"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build -c vite.content.config.ts && vite build -c vite.background.config.ts",
    "dev": "vite build -c vite.content.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node --test --test-concurrency=1 e2e/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
